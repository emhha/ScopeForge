# 后端环境变量示例（启动前导出，或由运行环境注入）

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SCOPEFORGE_LLM_PROVIDER=
SCOPEFORGE_LLM_MODEL=
SCOPEFORGE_LLM_BASE_URL=
SCOPEFORGE_LLM_PROXY=

# 网络测绘（可选；也可在系统配置的测绘数据源卡片设置）
SCOPEFORGE_FOFA_KEY=
SCOPEFORGE_FOFA_EMAIL=
SCOPEFORGE_HUNTER_KEY=
SCOPEFORGE_QUAKE_KEY=
